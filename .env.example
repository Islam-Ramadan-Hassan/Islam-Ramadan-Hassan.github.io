# GEMINI_API_KEY: Server-side only key for the Express /api/assistant/chat endpoint.
# Configure securely via the Environment Variables / Secrets panel.
# Never prefix with VITE_ and never expose to browser bundles.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ALLOWED_ORIGINS: Optional comma-separated list of additional browser origins allowed by server CORS.
# Example: ALLOWED_ORIGINS="https://islam-ramadan-hassan.github.io"
ALLOWED_ORIGINS=""
